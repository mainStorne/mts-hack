# Copy to .env and fill in. Never commit .env.

# --- database (docker compose up -d db) ---
POSTGRES_PASSWORD=support
DATABASE_URL=postgresql://support:support@127.0.0.1:5432/support

# --- the language model: any OpenAI-compatible server (llama.cpp, vLLM, a hosted API) ---
LLM_ROUTE=http://localhost:8080/v1
# LLM_API_KEY=not-needed       # set for a hosted API
# LLM_MODEL=local              # llama.cpp ignores it; hosted APIs need the real name
# LLM_THINKING=true            # Qwen-style thinking (chat_template_kwargs.enable_thinking); false = faster, no reasoning
# GUARDRAIL_ENABLED=true       # screen every message before the agent (one more short model call)

# --- tracing of the agent in Arize Phoenix (optional; unset = off). docker compose up -d phoenix, UI on this address ---
# PHOENIX_ENDPOINT=http://localhost:6006

# --- HTTP API `support-api` ---
# API_HOST=127.0.0.1
# API_PORT=8000
# API_ROOT_PATH=/api            # when a proxy serves the API under a prefix
# API_CORS_ALLOW_ORIGIN_REGEX=.*

# --- knowledge-base search: embeddings + reranker (optional; unset = word match). llama.cpp: --embeddings / --reranking ---
# EMBEDDINGS_ROUTE=http://localhost:8081/v1
# EMBEDDINGS_MODEL=bge-m3
# RERANKER_ROUTE=http://localhost:8083/v1
# RERANKER_MODEL=bge-reranker-v2-m3
# RERANKER_MIN_SCORE=0.0        # raw reranker scores below this count as "not found"; tune on your questions
