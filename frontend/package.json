{
  "name": "support-agent-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite dev --port 3000 --host",
    "build": "vite build",
    "preview": "vite build && vite preview --port 3000 --host 0.0.0.0",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --build --noEmit",
    "prettify": "prettier --write --list-different .",
    "prettier:check": "prettier --ignore-unknown --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lingui:extract": "lingui extract",
    "lingui:extract:watch": "lingui extract --watch"
  },
  "dependencies": {
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/rubik": "^5.2.8",
    "@iconify/json": "^2.2.474",
    "@iconify/tailwind4": "^1.2.3",
    "@lingui/core": "^6.10.0",
    "@lingui/react": "^6.10.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "^1.170.2",
    "@tanstack/router-plugin": "^1.168.3",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "clsx": "^2.1.1",
    "daisyui": "^5.5.19",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "usehooks-ts": "^3.1.1",
    "vite": "^8.0.13"
  },
  "devDependencies": {
    "@lingui/cli": "^6.10.0",
    "@lingui/vite-plugin": "^6.10.0",
    "eslint-plugin-lingui": "^0.16.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.9"
  }
}
